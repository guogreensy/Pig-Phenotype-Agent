# ---- 密钥（必填之一）----
# 智谱开放平台（GLM-4.6V-Flash 免费）：https://open.bigmodel.cn
ZHIPUAI_API_KEY=

# 阿里云百炼（qwen3-vl-plus，视觉模型有免费额度）
DASHSCOPE_API_KEY=

# ---- 服务商与模型 ----
# zhipu | dashscope
PIG_PROVIDER=zhipu
# 留空则使用该服务商的默认模型。
# 实测说明（2026-10-19）：智谱免费视觉模型中 glm-4.6v-flash 在当前网络下
# 429 限流非常频繁（模型级拥堵），glm-4.1v-thinking-flash 明显更稳定，
# 因此本项目实验统一使用 glm-4.1v-thinking-flash。
PIG_MODEL=glm-4.1v-thinking-flash

# ---- 助手（工具调用）模型 ----
# 视觉模型不返回 tool_calls，助手另用一支模型；留空则默认 glm-4.5-flash。
# 实测（2026-11-07）：glm-4.5-flash 原生返回 tool_calls，关闭思考后单步约 1-3 秒。
PIG_TOOL_MODEL=glm-4.5-flash

# ---- 调用参数（三组提示词对照实验必须保持一致）----
PIG_TEMPERATURE=0
# 思考型模型推理较长，留足输出空间避免答案被截断
PIG_MAX_TOKENS=2048
PIG_TIMEOUT=120
# 免费模型偶发 429（模型级拥堵），重试次数给足
PIG_MAX_RETRIES=8

# ---- 批量实验的限流与成本闸 ----
# 每秒请求数；实测 0.5 在免费模型上可稳定跑完 600 次调用且零失败
PIG_QPS=0.5
# 并发线程数
PIG_CONCURRENCY=2
# 单次实验最多调用次数（硬上限，防止误跑耗尽额度）
PIG_MAX_CALLS=1500

# ---- 图片预处理 ----
# 送入模型前的最长边像素
PIG_IMAGE_MAX_SIDE=512
PIG_JPEG_QUALITY=90

# ---- Web 服务 ----
PIG_HOST=127.0.0.1
PIG_PORT=7860
